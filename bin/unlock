#!/usr/bin/env bash
# Break out of a stuck lock screen: run from a text console, then return to
# the graphical session's VT (printed at the end).
#
# ext-session-lock keeps the session locked when the locker dies, so killing
# hyprlock alone leaves a blank locked screen. End hyprlock, then clear the
# orphaned lock; Hyprland refuses to clear one that still has a live client.

set -uo pipefail

# A console login lacks the signature; find it in the runtime directory.
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    # The session compositor's, by the test session-start.sh makes: a lock
    # whose pid is a running Hyprland (a crash leaves the lock behind) without
    # WAYLAND_DISPLAY in its environment (a nested one has it). Directories
    # sort by build before time, so the newest lock wins, not the first.
    sig=""
    newest=""
    for d in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/hypr/*/; do
        lock="$d/hyprland.lock"
        read -r pid < "$lock" 2>/dev/null || continue
        [[ "$pid" =~ ^[0-9]+$ && "$(cat "/proc/$pid/comm" 2>/dev/null)" == Hyprland ]] || continue
        grep -q '^WAYLAND_DISPLAY=' <<<"$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null)" && continue
        if [[ -z "$newest" || "$lock" -nt "$newest" ]]; then
            newest=$lock
            sig="$(basename "$d")"
        fi
    done
    [[ -n "$sig" ]] || { echo "unlock: no running Hyprland instance found" >&2; exit 1; }
    export HYPRLAND_INSTANCE_SIGNATURE="$sig"
fi

hyprctl version >/dev/null 2>&1 || {
    echo "unlock: hyprctl cannot reach the compositor" >&2; exit 1; }

if pidof hyprlock >/dev/null 2>&1; then
    echo "unlock: ending hyprlock"
    pkill -x hyprlock
    for _ in {1..40}; do
        pidof hyprlock >/dev/null 2>&1 || break
        sleep 0.25
    done
    pidof hyprlock >/dev/null 2>&1 && pkill -9 -x hyprlock
fi

back="switch back to the graphical session's VT"
for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$(id -un)" '$3 == u {print $1}'); do
    [[ "$(loginctl show-session "$s" -p Type --value 2>/dev/null)" == wayland ]] || continue
    vt=$(loginctl show-session "$s" -p VTNr --value 2>/dev/null)
    [[ "$vt" =~ ^[1-9][0-9]*$ ]] && back="switch back with Ctrl+Alt+F$vt"
    break
done

out=$(hyprctl eval 'hl.clear_crashed_lockscreen()' 2>&1)
case "$out" in
    ok*)                    echo "unlock: cleared, $back" ;;
    *"is not locked"*)      echo "unlock: the session was not locked" ;;
    *"refusing"*)           echo "unlock: a lock client is still alive; run this again" >&2; exit 1 ;;
    *)                      echo "unlock: $out" >&2; exit 1 ;;
esac
