#!/usr/bin/env bash
# Front end to systemd/user/bar.service, which supervises the bar.
#
#   bar                 start it (no-op if running)
#   bar --restart       restart it; picks up QML changes
#   bar --stop          stop it
#   bar --status        unit status and last log lines
#   bar --log           follow its log
#   bar --once          run quickshell in the foreground, outside the unit
#
# quickshell -n refuses a second copy of the same config: stop the unit before
# `bar --once` on it, or point BAR_CONFIG_DIR elsewhere.

set -uo pipefail

CONFIG_DIR="${BAR_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/bar}"
UNIT=bar.service
LOG_RULES='quickshell.hyprland.ipc.events.debug=false;quickshell.wayland.toplevel.debug=false;quickshell.dbus.properties.debug=false'

runner() {
    if command -v qs >/dev/null 2>&1; then echo qs; else echo quickshell; fi
}

case "${1:-}" in
    # reset-failed first: start-limit-hit refuses start and restart alike.
    # Side effect: NRestarts is zeroed, so crash loops show only in --log.
    "")         systemctl --user reset-failed "$UNIT" 2>/dev/null
                exec systemctl --user start "$UNIT" ;;
    --restart)  systemctl --user reset-failed "$UNIT" 2>/dev/null
                exec systemctl --user restart "$UNIT" ;;
    --stop)     exec systemctl --user stop "$UNIT" ;;
    --status)   exec systemctl --user --no-pager status "$UNIT" ;;
    --log)      exec journalctl --user -u "$UNIT" -f ;;
    --once)
        command -v "$(runner)" >/dev/null 2>&1 || { echo "bar: quickshell is not installed" >&2; exit 1; }
        [[ -f "$CONFIG_DIR/shell.qml" ]] || { echo "bar: no shell.qml under $CONFIG_DIR" >&2; exit 1; }
        cd "$HOME" 2>/dev/null || cd /
        exec "$(runner)" -n --log-rules "$LOG_RULES" -p "$CONFIG_DIR"
        ;;
    *)
        echo "usage: bar [--restart|--stop|--status|--log|--once]" >&2
        exit 2
        ;;
esac
