#!/usr/bin/env bash
# ============================================================================
# bar - the status bar, by way of its systemd user unit
#
# The bar is quickshell under systemd/user/bar.service, which is what restarts
# it after a crash, gives up on a crash loop, and ends it with the session.
# This script used to be that supervisor. What is left is the front end, so
# the commands people typed keep working:
#
#   bar                 start it, or do nothing if it is running
#   bar --restart       restart it, which is how a QML change is picked up
#   bar --stop          stop it
#   bar --status        whether it is running, and the last log lines
#   bar --log           follow its log
#   bar --once          run quickshell in the foreground, outside the unit
#
# --once is for working on the QML: BAR_PREVIEW=bottom bar --once puts a
# second copy under the live one (see README). quickshell's -n means two
# copies of one config cannot run, so stop the unit first for a preview of
# the same config, or use a different BAR_CONFIG_DIR.
# ============================================================================

set -uo pipefail

CONFIG_DIR="${BAR_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/bar}"
UNIT=bar.service
LOG_RULES='quickshell.hyprland.ipc.events.debug=false;quickshell.wayland.toplevel.debug=false;quickshell.dbus.properties.debug=false'

runner() {
    if command -v qs >/dev/null 2>&1; then echo qs; else echo quickshell; fi
}

case "${1:-}" in
    "")         exec systemctl --user start "$UNIT" ;;
    --restart)  exec systemctl --user restart "$UNIT" ;;
    --stop)     exec systemctl --user stop "$UNIT" ;;
    --status)   exec systemctl --user --no-pager status "$UNIT" ;;
    --log)      exec journalctl --user -u "$UNIT" -f ;;
    --once)
        command -v "$(runner)" >/dev/null 2>&1 || { echo "bar: quickshell is not installed" >&2; exit 1; }
        [[ -f "$CONFIG_DIR/shell.qml" ]] || { echo "bar: no shell.qml under $CONFIG_DIR" >&2; exit 1; }
        cd "$HOME" 2>/dev/null || cd /
        exec "$(runner)" -n --log-rules "$LOG_RULES" -p "$CONFIG_DIR"
        ;;
    *)
        echo "usage: bar [--restart|--stop|--status|--log|--once]" >&2
        exit 2
        ;;
esac
