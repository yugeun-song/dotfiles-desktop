#!/usr/bin/env bash
# Gets a Hyprland session back from a text console (Ctrl+Alt+F2, log in, then
# Ctrl+Alt+F1 back), or typed blind into a terminal: a disabled panel, a
# test-created output, DPMS off, a display lit but black, a dead service, a
# bar gone from a display or not answering, a hung compositor. A stuck lock
# screen is `unlock`'s job.
#
# Nothing machine-specific: everything comes from the uid, the lock file,
# sysfs connectors and the session target, since a console login has none of
# the session's environment.
#
#   recover-desktop            diagnose, then safe repairs (never ends anything)
#   recover-desktop --status   diagnose only
#   recover-desktop --relight  the repairs, then a full modeset of every lit
#                              display (each blinks once)
#   recover-desktop --logout   ask the compositor to exit, back to the greeter
#   recover-desktop --kill     SIGTERM, then SIGKILL, the compositor

set -uo pipefail

MODE="${1:-}"
case "$MODE" in
    ""|--status|--relight|--logout|--kill) ;;
    *) echo "usage: ${0##*/} [--status|--relight|--logout|--kill]" >&2; exit 2 ;;
esac

UID_NOW=$(id -u)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID_NOW}"
RT="$XDG_RUNTIME_DIR"
TARGET=hyprland-session.target

say()  { printf 'recover: %s\n' "$*"; }
warn() { printf 'recover: %s\n' "$*" >&2; }

# hyprctl never returns from a hung compositor.
HC_TIMEOUT=5
hc() { timeout "$HC_TIMEOUT" hyprctl "$@"; }

for tool in hyprctl jq timeout; do
    command -v "$tool" >/dev/null 2>&1 || { warn "$tool is not installed; cannot read the compositor's state"; exit 1; }
done

# ---------------------------------------------------------------------------
# Which compositor.
# ---------------------------------------------------------------------------
# Only a live instance keeps hyprland.lock (line 1 pid, line 2 wayland socket).
# Read from the file because a hung compositor cannot be asked.
lock_pid() { sed -n '1{/^[0-9][0-9]*$/p}' "$RT/hypr/$1/hyprland.lock" 2>/dev/null; }
lock_display() { sed -n 2p "$RT/hypr/$1/hyprland.lock" 2>/dev/null; }

# A nested compositor (e.g. monitors-selftest.sh) has WAYLAND_DISPLAY in its
# environment; the greetd-started session one does not. Newest wins per kind.
live_instance() {
    local d sig pid env_display newest="" newest_session=""
    if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" && -e "$RT/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/hyprland.lock" ]]; then
        printf '%s\n' "$HYPRLAND_INSTANCE_SIGNATURE"
        return 0
    fi
    for d in "$RT"/hypr/*/; do
        [[ -e "$d/hyprland.lock" ]] || continue
        sig=$(basename "$d")
        [[ -z "$newest" || "$d" -nt "$RT/hypr/$newest/" ]] && newest="$sig"
        pid=$(lock_pid "$sig")
        [[ -n "$pid" && -r "/proc/$pid/environ" ]] || continue
        env_display=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -c '^WAYLAND_DISPLAY=')
        (( env_display == 0 )) || continue
        [[ -z "$newest_session" || "$d" -nt "$RT/hypr/$newest_session/" ]] && newest_session="$sig"
    done
    [[ -n "$newest_session" ]] && { printf '%s\n' "$newest_session"; return 0; }
    [[ -n "$newest" ]] || return 1
    printf '%s\n' "$newest"
}

SIG=$(live_instance) || {
    warn "no running compositor: no hyprland.lock under $RT/hypr"
    warn "the session has ended; log in again at the greeter, or check: systemctl status greetd"
    exit 1
}
export HYPRLAND_INSTANCE_SIGNATURE="$SIG"

HL_PID=$(lock_pid "$SIG")
WL=$(lock_display "$SIG")
[[ -n "$WL" ]] && export WAYLAND_DISPLAY="$WL"

# Fallbacks should the lock file stop carrying the pid.
if [[ ! "$HL_PID" =~ ^[0-9]+$ ]]; then
    HL_PID=$(hc instances -j 2>/dev/null | jq -r --arg s "$SIG" '.[] | select(.instance == $s) | .pid' 2>/dev/null | head -1)
fi
if [[ ! "$HL_PID" =~ ^[0-9]+$ ]]; then
    HL_PID=$(pgrep -u "$UID_NOW" -x Hyprland 2>/dev/null)
    [[ "$(printf '%s\n' "$HL_PID" | grep -c .)" == 1 ]] || HL_PID=""
fi

# ---------------------------------------------------------------------------
# What a process that is not answering is doing.
# ---------------------------------------------------------------------------
# R/S: wedged in userspace, a signal reaches it. D: inside an uninterruptible
# kernel call, not even SIGKILL is delivered; only a reboot helps.
# The comm field may contain spaces, so parse after the last ')'.
proc_state() {
    local line
    line=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    printf '%s\n' "${line##*) }" | cut -d' ' -f1
}

state_words() {
    case "$1" in
        R) echo "running" ;;
        S) echo "sleeping, interruptible" ;;
        D) echo "in an uninterruptible kernel call" ;;
        T) echo "stopped" ;;
        t) echo "stopped by a tracer" ;;
        Z) echo "a zombie, waiting to be reaped" ;;
        *) echo "in state ${1:-unknown}" ;;
    esac
}

# wchan (e.g. a modeset wait) is a hint only: empty when running, unreadable on
# some kernels.
describe_process() {
    local pid="${1:-}" state wchan
    if [[ ! "$pid" =~ ^[0-9]+$ ]] || [[ ! -d "/proc/$pid" ]]; then
        warn "no live process to look at"
        return 1
    fi
    state=$(proc_state "$pid")
    wchan=$(cat "/proc/$pid/wchan" 2>/dev/null)
    say "pid $pid is $(state_words "$state")${wchan:+, waiting in $wchan}"
    if [[ "$state" == "D" ]]; then
        warn "no signal reaches a process in that state, SIGKILL included"
        return 2
    fi
    return 0
}

# Polls: not the parent, so no wait(2). A zombie counts as gone.
gone_within() {
    local seconds="$1" pid="$2" i
    for (( i = 0; i < seconds * 4; i++ )); do
        [[ -d "/proc/$pid" ]] || return 0
        [[ "$(proc_state "$pid")" == "Z" ]] && return 0
        sleep 0.25
    done
    [[ ! -d "/proc/$pid" ]]
}

if [[ "$MODE" == "--kill" ]]; then
    if [[ ! "$HL_PID" =~ ^[0-9]+$ ]] || [[ ! -d "/proc/$HL_PID" ]]; then
        warn "the lock file names no live pid; nothing to kill"
        exit 1
    fi
    describe_process "$HL_PID"
    # Ending the compositor loses the session's windows. The greetd session
    # entry runs start-hyprland, which relaunches only after a crash; a clean
    # exit returns to the greeter on vt1.
    say "sending SIGTERM to Hyprland ($HL_PID); the greeter returns on vt1 and this session's windows are lost"
    kill -TERM "$HL_PID" 2>/dev/null || { warn "could not signal $HL_PID"; exit 1; }
    gone_within 5 "$HL_PID" && { say "it exited"; exit 0; }

    # A stalled event loop never runs its SIGTERM handler (it is a queued event),
    # so escalation is the point of --kill, not an extra.
    warn "still there after 5s; sending SIGKILL"
    kill -KILL "$HL_PID" 2>/dev/null
    gone_within 5 "$HL_PID" && { say "it exited"; exit 0; }

    warn "still there after SIGKILL, so it is inside a kernel call"
    describe_process "$HL_PID"
    warn "nothing from userspace ends it now; reboot from this console: systemctl reboot"
    exit 1
fi

# ---------------------------------------------------------------------------
# Diagnose.
# ---------------------------------------------------------------------------
# Everything below needs a responsive compositor. A hung one ends the run here,
# with advice that depends on whether a signal can reach it at all.
if ! hc version >/dev/null 2>&1; then
    warn "compositor $SIG (pid ${HL_PID:-?}) is not answering hyprctl within ${HC_TIMEOUT}s"
    describe_process "${HL_PID:-}"
    stuck=$?
    echo >&2
    warn "the session is still running: its windows and their unsaved work are still there,"
    warn "and nothing that needs the compositor can be repaired while it stays this way."
    if (( stuck == 2 )); then
        warn "it is waiting on the kernel, so no signal will end it. Either the call returns"
        warn "on its own, or the machine is restarted: systemctl reboot"
    else
        warn "to end it and get the greeter back, losing the windows: ${0##*/} --kill"
    fi
    exit 1
fi

if [[ "$MODE" == "--logout" ]]; then
    say "asking the compositor to exit"
    hc dispatch 'hl.dsp.exit()'
    exit $?
fi

# Kernel connectors and built-in panels; same classification as
# hypr/config/monitors.lua. RECOVER_DRM_DIR stands in for /sys/class/drm in
# the tests, whose headless outputs it lists.
DRM_DIR="${RECOVER_DRM_DIR:-/sys/class/drm}"
declare -A KERNEL=()
INTERNAL=()
for status in "$DRM_DIR"/card*-*/status; do
    [[ -e "$status" ]] || continue
    name=$(basename "$(dirname "$status")")
    name="${name#card*-}"
    KERNEL["$name"]=1
    case "$name" in
        eDP*|LVDS*|DSI*) INTERNAL+=("$name") ;;
    esac
done

# What a display shows: the brightest channel of its picture scaled down 20
# times, read from a screencopy and never written anywhere. 0 is nothing but
# black, the bar included, which no working desktop shows: the screensaver's
# layer, or the compositor's own black over an output it has just lit. No
# answer within 3 s (the session is not on screen, as from a text console)
# is no answer, and the run stops asking (CAN_SEE 2). Never asked of an
# output with DPMS off, whose screencopy never completes (Hyprland 0.56.2).
CAN_SEE=0
command -v grim >/dev/null 2>&1 && command -v od >/dev/null 2>&1 && CAN_SEE=1
peak() {
    timeout 3 grim -o "$1" -s 0.05 -t ppm - 2>/dev/null | od -An -v -tu1 | awk '
        { for (i = 1; i <= NF; i++) { if (h < 3) { if ($i == 10) h++; continue } if ($i > m) m = $i } }
        END { if (h < 3) exit 1; print m + 0 }'
}

report() {
    local json real=0 synthetic=() fake=() lit=() screens=() line name disabled dpms mirror
    json=$(hc monitors all -j 2>/dev/null) || { warn "could not list monitors"; return 1; }
    say "compositor $SIG, pid ${HL_PID:-?}, display ${WL:-?}"
    while IFS=$'\t' read -r name disabled dpms mirror line; do
        [[ -n "$name" ]] || continue
        printf '  %-12s %s  %s\n' "$name" "$([[ "$disabled" == "true" ]] && echo off || echo on )" "$line"
        # A connector the kernel lists is real whatever its name. One that
        # mirrors is no screen of its own to clients, so it has no bar.
        if [[ -n "${KERNEL[$name]:-}" ]]; then
            if [[ "$disabled" != "true" ]]; then
                real=$((real + 1))
                [[ "$mirror" == "none" ]] && screens+=("$name")
                [[ "$dpms" == "true" ]] && lit+=("$name")
            fi
            continue
        fi
        case "$name" in
            FALLBACK|HEADLESS-*) synthetic+=("$name") ;;
            *) fake+=("$name") ;;
        esac
    done < <(printf '%s' "$json" | jq -r '.[] | [.name, (.disabled // false), .dpmsStatus, (.mirrorOf // "none"), "\(.width)x\(.height)@\(.refreshRate|floor) at \(.x)x\(.y) scale \(.scale) dpms \(.dpmsStatus)"] | @tsv')
    REAL_ENABLED=$real
    SCREENS=("${screens[@]}")
    FAKE_OUTPUTS=("${fake[@]}")
    LIT=("${lit[@]}")
    (( ${#synthetic[@]} )) && say "synthetic outputs present: ${synthetic[*]}"
    (( ${#fake[@]} )) && say "outputs the kernel does not have (created by hand or by a test): ${fake[*]}"
    say "real outputs enabled: $real; built-in panels known to the kernel: ${INTERNAL[*]:-none}"
    look
    if command -v systemctl >/dev/null 2>&1; then
        say "session target: $(systemctl --user is-active "$TARGET" 2>/dev/null)"
        local u
        for u in "${UNITS[@]}"; do
            printf '  %-32s %s\n' "$u" "$(systemctl --user is-active "$u" 2>/dev/null)"
        done
    fi
}

# Which lit displays show nothing but black (BLACK), which the bar's
# screensaver covers (SAVER), which could not be read (UNSEEN).
look() {
    local name value
    BLACK=() UNSEEN=() SAVER=()
    mapfile -t SAVER < <(hc layers -j 2>/dev/null | jq -r \
        'to_entries[] | select([.value.levels[][]? | .namespace] | index("quickshell:screensaver")) | .key' 2>/dev/null)
    (( ${#SAVER[@]} )) && say "the bar's screensaver black is up on: ${SAVER[*]}"
    (( ${#LIT[@]} )) || return 0
    case "$CAN_SEE" in
        0) say "grim is not installed, so what each display shows is not checked"; return 0 ;;
        2) say "what each display shows cannot be read from here"; return 0 ;;
    esac
    for name in "${LIT[@]}"; do
        value=$(peak "$name")
        if [[ -z "$value" ]]; then
            UNSEEN+=("$name")
        elif [[ "$value" == 0 ]]; then
            BLACK+=("$name")
        fi
    done
    (( ${#BLACK[@]} )) && say "lit but showing nothing but black: ${BLACK[*]}"
    if (( ${#UNSEEN[@]} )); then
        say "could not read what these show (is the session on screen?): ${UNSEEN[*]}"
        (( ${#UNSEEN[@]} == ${#LIT[@]} )) && CAN_SEE=2
    fi
    return 0
}

# The bar, over its IPC socket. The path must be the one it was started with
# (bin/bar), or no instance answers. An answer is exit 0 with nothing
# printed: a missing target prints "Target not found." and exits 0 too. Only
# stdout is read, where qs puts those; stderr carries its warnings (a locale
# that is not UTF-8, as with no LANG set), which are no failure.
BAR_CONFIG="${BAR_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/bar}"
QS=$(command -v qs || command -v quickshell || true)
bar_call() {
    local out
    [[ -n "$QS" ]] || return 1
    out=$(timeout 3 "$QS" -p "$BAR_CONFIG" ipc call "$@" 2>/dev/null) || return 1
    [[ -z "$out" ]]
}

# What is wrong with the bar, in BAR_PROBLEM, empty when nothing is. A
# working bar answers over IPC, its "shell" target listed (what install.sh
# asks it for), and is drawn on every one of SCREENS; its window is the one
# layer under quickshell's default namespace, the name hypr/config/rules.lua
# matches it by. A hung bar never answers, hence the timeout; one a reload
# left in two generations answers "Not ready to accept queries yet." until
# it is restarted.
bar_state() {
    local out rc layers drawn=() missing=() name
    BAR_PROBLEM=""
    [[ -n "$QS" ]] || return 0
    out=$(timeout 3 "$QS" -p "$BAR_CONFIG" ipc show 2>/dev/null)
    rc=$?
    if (( rc == 124 )); then
        BAR_PROBLEM="does not answer over IPC within 3 s"
        return 0
    fi
    if ! grep -qx 'target shell' <<<"$out"; then
        BAR_PROBLEM="does not answer over IPC${out:+ (${out%%$'\n'*})}"
        return 0
    fi
    # No layer list is no verdict: an empty one would read as no bar anywhere.
    layers=$(hc layers -j 2>/dev/null) || return 0
    mapfile -t drawn < <(printf '%s' "$layers" | jq -r \
        'to_entries[] | select([.value.levels[][]? | .namespace] | index("quickshell")) | .key' 2>/dev/null)
    for name in "${SCREENS[@]}"; do
        [[ " ${drawn[*]} " == *" $name "* ]] || missing+=("$name")
    done
    (( ${#missing[@]} )) && BAR_PROBLEM="is not drawn on: ${missing[*]}"
    return 0
}

bar_report() {
    if [[ -z "$QS" ]]; then
        say "quickshell is not installed, so the bar is not checked"
        return 0
    fi
    bar_state
    if [[ -n "$BAR_PROBLEM" ]]; then
        say "the bar $BAR_PROBLEM"
    else
        say "the bar answers and is drawn on every display"
    fi
}

# The session's units are the target's Wants=, listed only in the target file.
UNITS=()
if command -v systemctl >/dev/null 2>&1; then
    read -r -a UNITS <<<"$(systemctl --user show "$TARGET" -p Wants --value 2>/dev/null)"
fi

REAL_ENABLED=0
SCREENS=()
FAKE_OUTPUTS=()
LIT=()
BLACK=()
UNSEEN=()
SAVER=()
BAR_PROBLEM=""
report || exit 1
if [[ "$MODE" == "--status" ]]; then
    bar_report
    exit 0
fi

# ---------------------------------------------------------------------------
# Repair, safest first. Nothing here ends the session.
# ---------------------------------------------------------------------------
echo
for name in "${FAKE_OUTPUTS[@]}"; do
    say "removing $name, which no connector backs"
    hc output remove "$name" >/dev/null 2>&1 || warn "could not remove $name"
done

say "DPMS on for every output"
hc dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1 || warn "dpms request failed"

# Re-run the monitor policy if loaded; otherwise (config failed to load) ask
# for the built-in panel by rule. A reload follows if nothing lights up.
if [[ "$(hc repl 'return MONITORS ~= nil' 2>/dev/null)" == "true" ]]; then
    say "asking config/monitors.lua to re-evaluate"
    hc eval 'MONITORS.evaluate("recover", false)' >/dev/null 2>&1 || warn "evaluate failed"
else
    say "the monitor policy module is not loaded; enabling the built-in panel by rule"
    for name in "${INTERNAL[@]}"; do
        hc eval "hl.monitor({ output = \"$name\", disabled = false, mode = \"highrr\", position = \"auto\", scale = \"1\" })" >/dev/null 2>&1 \
            || warn "rule for $name refused"
    done
fi
sleep 3

REAL_ENABLED=0
report >/dev/null 2>&1
if (( REAL_ENABLED == 0 )); then
    # A reload clears every rule and re-runs the policy, which re-arms its own
    # fallback at load. The panel is requested again afterwards regardless.
    say "still no real output enabled; reloading the configuration"
    hc reload >/dev/null 2>&1 || warn "reload failed"
    sleep 3
    if [[ "$(hc repl 'return MONITORS ~= nil' 2>/dev/null)" == "true" ]]; then
        hc eval 'MONITORS.evaluate("recover", false)' >/dev/null 2>&1 || warn "evaluate failed"
    else
        for name in "${INTERNAL[@]}"; do
            hc eval "hl.monitor({ output = \"$name\", disabled = false, mode = \"highrr\", position = \"auto\", scale = \"1\" })" >/dev/null 2>&1 \
                || warn "rule for $name refused"
        done
    fi
    sleep 2
fi

if command -v systemctl >/dev/null 2>&1; then
    # Units read the manager's environment, which may still name a replaced
    # compositor; push the live one before restarting units.
    say "telling the user manager which compositor this is"
    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        dbus-update-activation-environment --systemd HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY 2>/dev/null \
            || warn "could not update the activation environment"
    else
        systemctl --user import-environment HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY 2>/dev/null \
            || warn "could not update the manager environment"
    fi
    say "starting whatever in the session target has died"
    (( ${#UNITS[@]} )) && systemctl --user reset-failed "${UNITS[@]}" 2>/dev/null
    systemctl --user start "$TARGET" 2>/dev/null || warn "could not start $TARGET"
fi

# reset-failed first: start-limit-hit refuses a restart too. quickshell 0.3.2
# does not catch SIGTERM, so a hung bar ends at once, not at the stop timeout.
restart_bar() {
    systemctl --user reset-failed bar.service 2>/dev/null
    systemctl --user restart bar.service 2>/dev/null || warn "could not restart bar.service"
    BAR_RESTARTED=1
}

# A bar gone from a display or not answering is started anew; a working one
# is left alone, the user's call (a restart is seen). It is asked again two
# seconds later first: a display just enabled gets its bar a moment after, a
# bar the units step started may still be loading, and a reload under way
# lists its targets one by one. The wait for the new bar is bounded in time
# as well as in tries: a bar that still hangs takes three seconds to each ask.
BAR_RESTARTED=0
check_bar() {
    local i deadline
    [[ -n "$QS" ]] || return 0
    command -v systemctl >/dev/null 2>&1 || return 0
    bar_state
    [[ -n "$BAR_PROBLEM" ]] || return 0
    sleep 2
    bar_state
    [[ -n "$BAR_PROBLEM" ]] || return 0
    say "the bar $BAR_PROBLEM; starting it anew"
    restart_bar
    deadline=$((SECONDS + 15))
    for (( i = 0; i < 20 && SECONDS < deadline; i++ )); do
        sleep 0.5
        bar_state
        [[ -n "$BAR_PROBLEM" ]] || { say "the bar answers and is drawn on every display again"; return 0; }
    done
    warn "the bar still $BAR_PROBLEM; its log: journalctl --user -u bar.service"
    return 1
}

# A full modeset: DPMS off, then on. "DPMS on" above leaves a lit output
# untouched, so this is the one repair that reaches a display which stays
# dark although the compositor draws on it. Names go into Lua source, so one
# no connector would have is refused rather than escaped.
relight() {
    local name
    for name in "$@"; do
        [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || continue
        say "$name: DPMS off, then on (a full modeset; it blinks once)"
        hc dispatch "hl.dsp.dpms({ action = \"disable\", monitor = \"$name\" })" >/dev/null 2>&1
        sleep 1
        hc dispatch "hl.dsp.dpms({ action = \"enable\", monitor = \"$name\" })" >/dev/null 2>&1
    done
}

recheck() { report >/dev/null 2>&1; }

# Lit but black, cheapest first, each step only for what the one before left
# black: the bar's screensaver (its layer, or a darkness it still believes
# in), a modeset of each such display, then the bar itself, whose stop lights
# whatever it left off (bar.service ExecStopPost), unless check_bar has just
# started it anew. On 2026-10-17 the panel stayed black with no bar for a
# minute or two after the external was unplugged, reported lit, and nothing
# above changed it.
lift_black() {
    (( ${#BLACK[@]} )) || return 0
    say "lit but black: ${BLACK[*]}; asking the bar's screensaver to wake every display"
    if ! bar_call screensaver wake && ! bar_call screensaver lift 300; then
        warn "the bar did not answer over IPC"
    fi
    sleep 1
    recheck
    (( ${#BLACK[@]} )) || { say "every display shows a picture again"; return 0; }
    relight "${BLACK[@]}"
    sleep 1.5
    recheck
    (( ${#BLACK[@]} )) || { say "every display shows a picture again"; return 0; }
    if command -v systemctl >/dev/null 2>&1 && (( ! BAR_RESTARTED )); then
        say "still black: ${BLACK[*]}; restarting the bar"
        restart_bar
        sleep 3
        recheck
        (( ${#BLACK[@]} )) || { say "every display shows a picture again"; return 0; }
    fi
    warn "still nothing but black on: ${BLACK[*]}"
    return 1
}

recheck
check_bar
# A new bar took the old one's black with it.
(( BAR_RESTARTED )) && recheck
lift_black
if [[ "$MODE" == "--relight" ]]; then
    recheck
    relight "${LIT[@]}"
    sleep 1
fi

echo
report
bar_report
# Exit 1 while a display still shows nothing or the bar is not right, for a
# caller to act on.
STATUS=0
(( ${#BLACK[@]} )) && STATUS=1
[[ -n "$BAR_PROBLEM" ]] && STATUS=1
echo
[[ "$MODE" == "--relight" ]] \
    || say "if a display stays dark although this shows it lit: ${0##*/} --relight, a modeset of each"
say "if the screen is still dark: ${0##*/} --logout, then log in again; ${0##*/} --kill if the compositor hangs"
exit "$STATUS"
