# dotfiles-desktop
# Clipboard history, text half. Kept out of the shell so it survives a shell
# restart, and one unit per type because wl-paste watches one type at a time.
[Unit]
Description=Clipboard history (text)
PartOf=hyprland-session.target
After=hyprland-session.target
Requisite=hyprland-session.target
ConditionPathExists=/usr/bin/wl-paste
ConditionPathExists=/usr/bin/cliphist
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/wl-paste --type text --watch cliphist store
Restart=on-failure
RestartSec=1
Slice=session.slice
