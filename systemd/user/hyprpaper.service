# dotfiles-desktop
# The wallpaper. A separate program rather than something the bar draws, so a
# bar restart leaves the desktop looking like a desktop.
#
# hyprpaper comes up with no image: its configuration cannot name the file,
# for the reason written in hypr/hyprpaper.conf. wallpaper.sh --reload hands
# it the path over IPC, waiting for the socket first. It runs after every
# start, so a hyprpaper that crashed and came back gets its image back too,
# which the old autostart only did on the next login. The leading dash keeps
# a missing image from failing the unit.
[Unit]
Description=Wallpaper
PartOf=hyprland-session.target
After=hyprland-session.target
Requisite=hyprland-session.target
ConditionPathExists=/usr/bin/hyprpaper
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/usr/bin/hyprpaper
ExecStartPost=-%E/hypr/scripts/wallpaper.sh --reload
Restart=on-failure
RestartSec=1
Slice=session.slice
