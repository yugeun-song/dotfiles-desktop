# dotfiles-desktop
# Clipboard history, image half. See cliphist-text.service.
[Unit]
Description=Clipboard history (images)
PartOf=hyprland-session.target
After=hyprland-session.target
Requisite=hyprland-session.target
ConditionPathExists=/usr/bin/wl-paste
ConditionPathExists=/usr/bin/cliphist
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/wl-paste --type image --watch cliphist store
Restart=on-failure
RestartSec=1
Slice=session.slice
