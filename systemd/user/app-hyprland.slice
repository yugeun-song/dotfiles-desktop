# dotfiles-desktop
# Where the programs opened from the bar live.
#
# They used to live in bar.service's control group, because execDetached
# double-forks and a fork does not leave its cgroup -- so `bar --restart` closed
# every window the launcher had opened. app-scope.sh puts them here instead.
#
# PartOf, so this trades no leak for a worse one: stopping a slice stops what is
# in it, and session-watch.sh stops the target when the compositor exits.
#
# A slice needs no file to exist -- systemd builds one from the name -- so this
# one is here only for that dependency. Without it the programs still start and
# are reaped at logout instead.
[Unit]
Description=Programs started from the Hyprland session
PartOf=hyprland-session.target
