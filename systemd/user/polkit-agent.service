# dotfiles-desktop
# Polkit agent; the script runs the first one installed and reports if none.
[Unit]
Description=Polkit authentication agent
PartOf=hyprland-session.target
After=hyprland-session.target
Requisite=hyprland-session.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%E/hypr/scripts/polkit-agent.sh
# always, not on-failure: see bar.service.
Restart=always
RestartSec=1
Slice=session.slice
