# dotfiles-desktop
# Somewhere for anything asking for privileges to ask. Which agent is present
# depends on what the machine has; the script picks the first one it finds,
# and a machine with none simply cannot authenticate, which it reports.
[Unit]
Description=Polkit authentication agent
PartOf=hyprland-session.target
After=hyprland-session.target
Requisite=hyprland-session.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%E/hypr/scripts/polkit-agent.sh
# always, not on-failure, for the reason in bar.service: systemd counts SIGTERM
# and exit 0 as success, so on-failure left a unit killed by a stray pkill
# inactive with nothing failed. The start limit above still bounds it.
Restart=always
RestartSec=1
Slice=session.slice
