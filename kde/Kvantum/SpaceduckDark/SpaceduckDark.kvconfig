# Written by build.py; edit that, not this.
[%General]
author=dotfiles-desktop
comment=The bar's look for Qt applications
x11drag=none
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
mirror_doc_tabs=false
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=3
spread_progressbar=true
progressbar_thickness=6
composite=true
menu_shadow_depth=0
menu_separator_height=9
tooltip_shadow_depth=0
shadowless_popup=true
spread_menuitems=false
splitter_width=1
scroll_width=10
scroll_min_extent=36
scroll_arrows=false
transient_scrollbar=true
transient_groove=false
slider_width=4
slider_handle_width=16
slider_handle_length=16
check_size=16
inline_spin_indicators=true
vertical_spin_indicators=false
combo_as_lineedit=true
combo_menu=true
scrollable_menu=true
animate_states=true
respect_DE=true
no_inactiveness=true
spread_header=true
remove_extra_frames=true
groupbox_top_label=true
fill_rubberband=true
menubar_mouse_tracking=true
transparent_menutitle=true

[GeneralColors]
window.color=#0f111b
base.color=#0f111b
alt.base.color=#161926
button.color=#161926
light.color=#1c2033
mid.light.color=#1c2033
dark.color=#08090f
mid.color=#25272c
shadow.color=#000000
highlight.color=#7aa2f7
inactive.highlight.color=#7aa2f7
tooltip.base.color=#0f111b
text.color=#ecf0c1
window.text.color=#ecf0c1
button.text.color=#ecf0c1
disabled.text.color=#686f9a
tooltip.text.color=#ecf0c1
highlight.text.color=#0f111b
link.color=#7dcfff
link.visited.color=#bb9af7
progress.indicator.text.color=#ecf0c1

[Hacks]
respect_darkness=true
transparent_ktitle_label=true
transparent_menutitle=true
normal_default_pushbutton=true
no_selection_tint=true
kcapacitybar_as_progressbar=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=7
frame.bottom=7
frame.left=7
frame.right=7
interior=true
interior.element=button
indicator.element=arrow
indicator.size=12
text.normal.color=#ecf0c1
text.focus.color=#ecf0c1
text.press.color=#ecf0c1
text.toggle.color=#ecf0c1
text.shadow=false
text.margin.top=0
text.margin.bottom=0
text.margin.left=5
text.margin.right=5
text.iconspacing=6
min_width=+8

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin.left=2
text.margin.right=2
min_width=0

[ToolbarButton]
inherits=PanelButtonTool

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#bbbf9c
text.focus.color=#ecf0c1
text.bold=false
text.margin.top=4
text.margin.bottom=4
text.margin.left=6
text.margin.right=6

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=12

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[Focus]
inherits=PanelButtonCommand
frame=true
frame.element=focus
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=false

[GenericFrame]
inherits=PanelButtonCommand
frame=false
interior=false
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=2
text.margin.right=2

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=12

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
text.normal.color=#bbbf9c
text.focus.color=#ecf0c1
text.toggle.color=#ecf0c1
text.margin.left=8
text.margin.right=8

[TabFrame]
inherits=PanelButtonCommand
frame=false
interior=false

[TabBarFrame]
inherits=GenericFrame

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=texp
indicator.size=12

[HeaderSection]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=header
text.normal.color=#bbbf9c
text.focus.color=#ecf0c1
text.press.color=#ecf0c1
text.margin.top=4
text.margin.bottom=4

[SizeGrip]
indicator.element=sizegrip

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=toolbar
text.margin=0

[StatusBar]
inherits=Toolbar

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.normal.color=#ecf0c1
text.focus.color=#ecf0c1
text.bold=false

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5
text.margin=0
text.normal.color=#ecf0c1
text.focus.color=#ecf0c1
text.press.color=#0f111b
text.toggle.color=#0f111b

[Splitter]
inherits=PanelButtonCommand
frame=false
interior.element=splitter
indicator.element=splitter-grip

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=10

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5
indicator.element=grip

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.normal.color=#ecf0c1
text.focus.color=#0f111b
text.press.color=#0f111b
text.toggle.color=#0f111b
text.margin.top=0
text.margin.bottom=0
text.margin.left=2
text.margin.right=2
min_height=24

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5
text.margin.top=0
text.margin.bottom=0

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=mdi
text.normal.color=#bbbf9c
text.focus.color=#ecf0c1

[ComboBox]
inherits=PanelButtonCommand

[ToolbarComboBox]
inherits=ComboBox

[ToolbarLineEdit]
inherits=LineEdit

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
text.margin=0

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=true
interior.element=group
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
text.margin=0
text.normal.color=#ecf0c1

[ToolTip]
inherits=GenericFrame
frame=true
frame.element=tooltip
interior=true
interior.element=tooltip
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
text.margin=0
text.normal.color=#ecf0c1

[Window]
interior=false

[Dialog]
inherits=Window
