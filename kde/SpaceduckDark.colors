# Colour scheme for Qt and KDE applications.
#
# Written here rather than taken from a package, so the desktop needs no
# theme from the AUR to look like itself. It is the same palette the status
# bar uses (quickshell/bar/services/Theme.qml); a file manager that does not
# match the bar above it reads as two desktops sharing a screen.
#
# Only the colours live here. The widget style stays Breeze, which is an
# official package and the one piece of this that is compiled code.
#
# Deployed to ~/.local/share/color-schemes/ by install.sh, and named in
# kde/kdeglobals.

[General]
Name=Spaceduck Dark
ColorScheme=SpaceduckDark
shadeSortColumn=true

[Colors:Window]
BackgroundNormal=15,17,27
BackgroundAlternate=27,28,54
DecorationFocus=122,162,247
DecorationHover=125,207,255
ForegroundNormal=236,240,193
ForegroundActive=122,162,247
ForegroundInactive=104,111,154
ForegroundLink=125,207,255
ForegroundVisited=187,154,247
ForegroundNegative=247,118,142
ForegroundNeutral=224,175,104
ForegroundPositive=158,206,106

