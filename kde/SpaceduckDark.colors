# Colour scheme for Qt and KDE applications.
#
# Written here rather than taken from a package, so nothing about the look
# depends on the AUR. It is the same palette the status bar uses
# (quickshell/bar/services/Theme.qml); a file manager that does not match the
# bar above it reads as two desktops sharing a screen.
#
# The colour blocks below are duplicated in kde/kdeglobals, and have to stay
# identical. Qt and KDE applications read kdeglobals directly; this file is
# only what the settings dialog copies from when someone picks the scheme by
# name there. Editing one and not the other means the desktop and the settings
# dialog disagree about what the scheme is.

[General]
Name=Spaceduck Dark
ColorScheme=SpaceduckDark
shadeSortColumn=true

[Colors:Window]
BackgroundNormal=15,17,27
BackgroundAlternate=27,28,54
DecorationFocus=122,162,247
DecorationHover=125,207,255
ForegroundNormal=236,240,193
ForegroundActive=122,162,247
ForegroundInactive=104,111,154
ForegroundLink=125,207,255
ForegroundVisited=187,154,247
ForegroundNegative=247,118,142
ForegroundNeutral=224,175,104
ForegroundPositive=158,206,106

