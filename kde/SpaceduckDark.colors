# Window manager colours. Hyprland draws its own borders and ignores these,
# but Qt applications with client side decorations read them.
[WM]
activeBackground=27,28,54
activeForeground=236,240,193
inactiveBackground=15,17,27
inactiveForeground=104,111,154
activeBlend=122,162,247
inactiveBlend=104,111,154

[ColorEffects:Disabled]
Color=104,111,154
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0
IntensityEffect=0

# Off. An unfocused window that dims its own text is a window you have to
# click before you can read it, and with one screen there is always exactly
# one focused window and everything else greyed out.
[ColorEffects:Inactive]
ChangeSelectionColor=false
Enable=false
Color=104,111,154
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0
