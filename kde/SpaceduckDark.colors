# Window manager colours. Hyprland draws its own borders and ignores these,
# but Qt applications with client side decorations read them.
[WM]
activeBackground=27,28,54
activeForeground=236,240,193
inactiveBackground=15,17,27
inactiveForeground=104,111,154
activeBlend=122,162,247
inactiveBlend=104,111,154

# Disabled text is dimmed rather than greyed: the palette has one muted
# colour and using it for both keeps the scheme from drifting.
[ColorEffects:Disabled]
Color=104,111,154
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=104,111,154
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0
