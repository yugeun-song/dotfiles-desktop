# Colour scheme for Qt and KDE applications.
#
# Palette sources:
#   Spaceduck    https://github.com/pineapplegiant/spaceduck   (bg, fg, greys, selection)
#   Tokyo Night  https://github.com/folke/tokyonight.nvim      (blue, cyan, purple, green, orange)
#
# Same palette as the bar (quickshell/bar/services/Theme.qml), kept in-repo to
# avoid the AUR. Applications read the copy in kde/kdeglobals; this file is only
# what the settings dialog applies by name. Keep the colour blocks identical.

[General]
Name=Spaceduck Dark
ColorScheme=SpaceduckDark
shadeSortColumn=true

[Colors:Window]
BackgroundNormal=15,17,27
BackgroundAlternate=22,25,38
DecorationFocus=122,162,247
DecorationHover=125,207,255
ForegroundNormal=236,240,193
ForegroundActive=122,162,247
ForegroundInactive=104,111,154
ForegroundLink=125,207,255
ForegroundVisited=187,154,247
ForegroundNegative=247,118,142
ForegroundNeutral=224,175,104
ForegroundPositive=158,206,106

