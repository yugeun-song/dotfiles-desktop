# Hyprland ignores these; Qt client-side decorations read them.
[WM]
activeBackground=22,25,38
activeForeground=236,240,193
inactiveBackground=15,17,27
inactiveForeground=104,111,154
activeBlend=122,162,247
inactiveBlend=104,111,154

[ColorEffects:Disabled]
Color=104,111,154
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0
IntensityEffect=0

# Off: dimming unfocused windows greys out everything but one window.
[ColorEffects:Inactive]
ChangeSelectionColor=false
Enable=false
Color=104,111,154
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0
