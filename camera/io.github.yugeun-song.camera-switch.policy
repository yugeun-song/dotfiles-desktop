<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<!--
  dotfiles-desktop: installed by install.sh into /usr/share/polkit-1/actions/

  pkexec runs /usr/local/bin/camera-switch as root without a password for the
  session at the seat (allow_active): that session already holds the cameras
  through udev's uaccess, and the switch is meant for a key press. A remote or
  background session has to authenticate as an administrator. Under /usr/share
  because polkit reads actions from nowhere else.
-->
<policyconfig>
  <vendor>dotfiles-desktop</vendor>
  <action id="io.github.yugeun-song.camera-switch">
    <description>Turn the cameras on or off</description>
    <message>Authentication is required to turn the cameras on or off</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/camera-switch</annotate>
  </action>
</policyconfig>
